BOT_TOKEN=replace_with_token_from_BotFather

# fake - demo without real payments, yookassa - real SBP payments through YooKassa.
PAYMENT_PROVIDER=yookassa

# Public HTTPS URL available from YooKassa, for example https://tickets.example.ru
PUBLIC_BASE_URL=https://your-domain.example
RETURN_URL=https://your-domain.example/return
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Random secret used inside webhook URL.
WEBHOOK_SECRET=replace_with_long_random_string

# Required only for PAYMENT_PROVIDER=yookassa.
YOOKASSA_SHOP_ID=replace_with_shop_id
YOOKASSA_SECRET_KEY=replace_with_secret_key

DATABASE_PATH=data/bot.sqlite3
QR_OUTPUT_DIR=data/qr
QR_POOL_PATH=data/qr_pool.json
EXPORT_DIR=data/exports
FREE_QR_OUTPUT_DIR=data/free_qr
ALLOW_DYNAMIC_QR=true

# Telegram numeric user IDs allowed to run /export and /free.
# Example: ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=
